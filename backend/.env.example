# Required by the Legal AI Companion and Document Simplifier.
GOOGLE_API_KEY=replace_with_your_google_gemini_api_key

# Required for secure login tokens. Generate a unique random value locally;
# never reuse this placeholder or commit the real value.
SECRET_KEY=replace_with_a_long_random_secret

# Optional for local startup. The application uses this SQLite database by default.
DATABASE_URL=sqlite:///./legalsimple.db

# Required only when testing Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# Optional comma-separated origins when serving the frontend separately.
# FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
